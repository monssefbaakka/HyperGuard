{
  "uid": "pulsestream-service-health",
  "title": "Service Health",
  "description": "One screen per question: is the platform up, is it serving traffic cleanly, and is the JVM under it healthy.",
  "tags": ["pulsestream"],
  "style": "light",
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "links": [
    {
      "title": "PulseStream",
      "type": "dashboards",
      "tags": ["pulsestream"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(process_uptime_seconds, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Services up",
      "description": "Instances currently exporting metrics. A service that stops being scraped drops out of this count within one scrape interval.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#C0392B", "value": null },
              { "color": "#1F9254", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "count(process_uptime_seconds{job=~\"$job\"})", "legendFormat": "up" }
      ]
    },
    {
      "id": 2,
      "title": "Throughput",
      "description": "HTTP requests per second across the selected services, averaged over 5m.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#2A6FDB" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate",
      "description": "Share of requests answered 5xx over the last 5m. Client errors are excluded - they are the caller sending bad input, and they are broken out in Outcomes below.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1F9254", "value": null },
              { "color": "#D9822B", "value": 0.01 },
              { "color": "#C0392B", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\", outcome=\"SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "5xx share"
        }
      ]
    },
    {
      "id": 4,
      "title": "Avg latency",
      "description": "Mean server-side request duration over 5m. Micrometer exports no histogram buckets on these services, so this is sum/count - an average, not a percentile.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "-",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1F9254", "value": null },
              { "color": "#D9822B", "value": 0.25 },
              { "color": "#C0392B", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=~\"$job\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 5,
      "title": "Heap used",
      "description": "Worst heap utilisation across the selected services: used / max. Sustained above 90% is the shape that precedes an OutOfMemoryError.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "-",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1F9254", "value": null },
              { "color": "#D9822B", "value": 0.75 },
              { "color": "#C0392B", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(sum by (job) (jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"}) / sum by (job) (jvm_memory_max_bytes{job=~\"$job\", area=\"heap\"}))",
          "legendFormat": "peak heap"
        }
      ]
    },
    {
      "id": 6,
      "title": "Uptime",
      "description": "Time since the youngest selected service started. A drop here is a restart.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "noValue": "-",
          "color": { "mode": "fixed", "fixedColor": "#5B6B7F" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "min(process_uptime_seconds{job=~\"$job\"})", "legendFormat": "youngest" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 7,
      "title": "Request rate by service",
      "description": "Who is serving the traffic.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Outcomes",
      "description": "Every request, stacked by how it ended. Amber is the caller sending bad input; red is the platform failing.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 75,
            "gradientMode": "none",
            "showPoints": "never",
            "barAlignment": 0,
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SUCCESS" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F9254" } }]
          },
          {
            "matcher": { "id": "byName", "options": "CLIENT_ERROR" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D9822B" } }]
          },
          {
            "matcher": { "id": "byName", "options": "SERVER_ERROR" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C0392B" } }]
          },
          {
            "matcher": { "id": "byName", "options": "REDIRECTION" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#7C5CD6" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Latency: average vs slowest",
      "description": "The average is what most callers feel; the slowest single request in each scrape window (Micrometer's _max) is the tail timeouts come from. A flat average under a rising max means one endpoint is degrading.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 6,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*slowest.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#D9822B" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_sum{job=~\"$job\"}[$__rate_interval])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} avg"
        },
        {
          "expr": "max by (job) (http_server_requests_seconds_max{job=~\"$job\"})",
          "legendFormat": "{{job}} slowest"
        }
      ]
    },
    {
      "id": 11,
      "title": "Slowest endpoints",
      "description": "The five endpoints with the highest average duration over the last 5m. Where to look first when the latency stat turns amber.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#1F9254", "value": null },
              { "color": "#D9822B", "value": 0.25 },
              { "color": "#C0392B", "value": 1 }
            ]
          },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Avg latency" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.align", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "sortBy": [{ "displayName": "Avg latency", "desc": true }]
      },
      "targets": [
        {
          "expr": "topk(5, sum by (job, uri) (rate(http_server_requests_seconds_sum{job=~\"$job\"}[5m])) / sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"$job\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "job": "Service", "uri": "Endpoint", "Value": "Avg latency" },
            "indexByName": {}
          }
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Runtime",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "id": 12,
      "title": "Heap",
      "description": "Heap in use against the ceiling the JVM will not grow past. The sawtooth is normal; a rising floor is a leak.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*limit.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5B6B7F" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"})",
          "legendFormat": "{{job}} used"
        },
        {
          "expr": "sum by (job) (jvm_memory_max_bytes{job=~\"$job\", area=\"heap\"})",
          "legendFormat": "{{job}} limit"
        }
      ]
    },
    {
      "id": 13,
      "title": "CPU",
      "description": "Process CPU is this JVM's share; system CPU is the whole host. Process tracking system means the box is the bottleneck, not the service.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*system.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5B6B7F" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "process_cpu_usage{job=~\"$job\"}", "legendFormat": "{{job}} process" },
        { "expr": "system_cpu_usage{job=~\"$job\"}", "legendFormat": "{{job}} system" }
      ]
    },
    {
      "id": 14,
      "title": "GC pause",
      "description": "Seconds of stop-the-world pause per second of wall clock. 0.05 means the service is frozen 5% of the time, and that time is added to every latency figure above.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "#7C5CD6" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisSoftMax": 0.01
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Warnings and errors logged",
      "description": "Logged events per second at WARN and ERROR. The one signal here that catches failures which never reach an HTTP status - a Kafka publish that retried, a consumer that dropped a batch.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*warn.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D9822B" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*error.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C0392B" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (job, level) (rate(logback_events_total{job=~\"$job\", level=~\"warn|error\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{level}}"
        }
      ]
    }
  ]
}
